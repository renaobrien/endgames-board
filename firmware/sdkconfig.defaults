# ESP32-P4 target. Build: idf.py set-target esp32p4 && idf.py build
CONFIG_IDF_TARGET="esp32p4"
# Run on early (v0.x) and later (v1.x) P4 silicon
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 32 MB PSRAM (frame buffers live here)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
# 200 MHz PSRAM is gated behind experimental features (Elecrow's factory config does the same).
# The RGB panel reads its frame buffer from PSRAM: at 80 MHz (0.11.3, 0.11.4) the picture drifted sideways.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
# RGB panel ISR stays in flash (Elecrow does the same). IRAM-safe mode rejects esp_lvgl_port's flash-resident vsync callback.
# CONFIG_LCD_RGB_ISR_IRAM_SAFE is not set
# Wi-Fi via the onboard ESP32-C6: ESP-Hosted over SDIO slot 1, 4-bit, C6 reset on GPIO20 (active high)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=20
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=54
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=53
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=52
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=49
# HTTPS to endgam.es
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL's own pool: 256 KB here, plus 8 MB of PSRAM added at boot (main.c). Switching LVGL to the system
# malloc made 0.11.1 fail before app_main (main task couldn't be created), so the pool stays.
CONFIG_LV_MEM_SIZE_KILOBYTES=256
# LVGL's allocator only accepts extra pools up to this size; without it the 8 MB add fails and pieces can't be decoded
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=8192
CONFIG_FREERTOS_HZ=1000

# ESP-IDF 5.5 bug on P4 (esp-idf #19020): a main stack under ~8 KB can land in TCM and crash on the first NVS write.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LV_USE_QRCODE=y
# Over-the-air updates: roll back if a new version can't get back online
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# ESP-Hosted on P4 rev v1.x (esp-hosted #657, esp-hosted-mcu #167): transport buffers in PSRAM, slower SDIO link
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
